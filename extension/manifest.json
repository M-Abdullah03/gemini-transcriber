{
  "manifest_version": 3,
  "name": "Gemini Live Transcriber",
  "version": "1.1.0",
  "description": "Transcribes all Mac system audio in realtime with local Whisper and shows it above the Gemini prompt box.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "permissions": [
    "nativeMessaging"
  ]
}
